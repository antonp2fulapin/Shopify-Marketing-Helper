{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@modules/*": ["./modules/*"],
      "@server/*": ["./server/*"]
    },
    "types": ["node"]
  },
  "include": ["app", "modules", "server", "worker", "remix.config.ts"]
}
